<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Two network calls, both from the Heal tab and both started by a tap: the diagnosis (crash
        trace + the app's own source files go to the model) and the pull request (patched files go
        to GitHub). Nothing about the user goes anywhere; the app only ever talks about itself.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Stage 4. The app downloads the APK that CI built from its own merged pull request and
        installs it over itself through PackageInstaller. The grant is per app, in Settings
        ("Install unknown apps"); every install still goes through the system's own dialog.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SelfPr">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PackageInstaller reports the session's fate here: the user-action request, success, or why not. -->
        <receiver
            android:name=".platform.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
